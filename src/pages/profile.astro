---
import ProjectLink from '@components/astro/starwind/project-link.astro'
import StarwindLayout from '@layouts/starwind-layout.astro'
---

<StarwindLayout title='Profile'>
  <div class='max-w-7xl mx-auto px-4 pt-10 pb-16'>
    <div class='mb-8'>
      <div class='flex items-center gap-3'>
        <span class='text-gray-500 text-sm'>CV Download:</span>
        <a
          href='/cv/Alexander-Torrijos-Cv.docx'
          target='_blank'
          class='px-4 py-1.5 text-sm border border-gray-600 text-gray-300 hover:border-gray-400 hover:text-white rounded transition-colors'
        >
          Word Doc
        </a>
        <a
          href='/cv/Resume-Alexander-Torrijos.pdf'
          target='_blank'
          class='px-4 py-1.5 text-sm border border-gray-600 text-gray-300 hover:border-gray-400 hover:text-white rounded transition-colors'
        >
          PDF
        </a>
      </div>
    </div>

    <div class='grid grid-cols-1 md:grid-cols-3 gap-8'>
      <div class='md:col-span-2'>
        <div class='mb-6'>
          <div class='flex items-center gap-2 px-4 py-3 bg-gray-900 border border-gray-800 rounded-t-lg'>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              width='18'
              height='18'
              fill='currentColor'
              class='text-gray-400'
              viewBox='0 0 16 16'
            >
              <path
                d='M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v1.384l7.614 2.03a1.5 1.5 0 0 0 .772 0L16 5.884V4.5A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5'
              ></path>
              <path
                d='M0 12.5A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5V6.85L8.129 8.947a.5.5 0 0 1-.258 0L0 6.85z'
              ></path>
            </svg>
            <span class='text-white font-semibold text-sm'>Sample Work</span>
          </div>
          <div class='flex flex-col gap-3 p-3 bg-gray-900 border border-t-0 border-gray-800 rounded-b-lg'>
            <ProjectLink
              href='https://modest-kirch-7e8ca1.netlify.app/'
              title='React Quiz'
              description='Demo of a quiz app built with React.'
              isActive='true'
            />
            <ProjectLink
              href='http://bcshotels.azurewebsites.net/'
              title='.NET 4 Web Api'
              description='Sample Hotel Listing with Sorting and Pagination'
              isActive='true'
            />
            <ProjectLink
              href='http://stickyevents.azurewebsites.net/'
              title='Angularjs Google Maps Integration'
              description='Sample Angularjs Google Maps Integration'
              isActive='true'
            />
            <ProjectLink
              href='https://stormwild.github.io/speech/'
              title='Angular 7 SPA'
              description='Speech - Sample Angular 7 SPA for job application test'
              isActive='true'
            />
            <ProjectLink
              href='https://stormwild.github.io/angular-github-user-search/'
              title='Angular Github User Search API'
              description='Github User Search API frontend built with Angular.'
              isActive='false'
            />
            <ProjectLink
              href='https://stormwild.github.io/spacex/build/'
              title='React Redux SpaceX Flight API'
              description='SpaceX Flight API frontend built with React and Redux.'
              isActive='false'
            />
          </div>
        </div>
      </div>

      <div class='flex flex-col gap-6'>
        <div class='bg-gray-900 border border-gray-800 rounded-lg overflow-hidden'>
          <div class='px-4 py-3 bg-gray-800 text-white font-semibold text-sm'>Dev Profiles</div>
          <div class='divide-y divide-gray-800'>
            {
              [
                { href: 'https://github.com/stormwild/', label: 'Github' },
                { href: 'https://stackoverflow.com/users/92189/stormwild', label: 'Stackoverflow' },
                { href: 'https://codepen.io/stormwild/', label: 'CodePen' },
                { href: 'https://www.linkedin.com/in/stormwild/', label: 'LinkedIn' },
                { href: 'https://www.hackerrank.com/stormwild', label: 'HackerRank' },
              ].map((link) => (
                <a
                  href={link.href}
                  target='_blank'
                  rel='noopener noreferrer'
                  class='block px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800 transition-colors'
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class='bg-gray-900 border border-gray-800 rounded-lg overflow-hidden'>
          <div class='px-4 py-3 bg-gray-800 text-white font-semibold text-sm'>Design Profiles</div>
          <div class='divide-y divide-gray-800'>
            {
              [
                { href: 'https://www.behance.net/gallery/47208/Web-Design-Studies', label: 'Behance', disabled: false },
                { href: 'http://www.coroflot.com/stormwild', label: 'Coroflot', disabled: false },
                { href: 'http://stormwild.deviantart.com/gallery/', label: 'DeviantArt', disabled: false },
                { href: 'https://stormwild.carbonmade.com/', label: 'Carbonmade (offline)', disabled: true },
              ].map((link) => (
                <a
                  href={link.disabled ? undefined : link.href}
                  target={link.disabled ? undefined : '_blank'}
                  rel='noopener noreferrer'
                  class={`block px-4 py-2 text-sm transition-colors ${link.disabled ? 'text-gray-600 cursor-not-allowed' : 'text-gray-400 hover:text-white hover:bg-gray-800'}`}
                  aria-disabled={link.disabled}
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</StarwindLayout>
