---
import Card from '@components/astro/starwind/card.astro'
import Paginate from '@components/astro/starwind/paginate.astro'
import StarwindLayout from '@layouts/starwind-layout.astro'
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import { BLOG_PAGE_ROOT, BLOG_POST_ROOT } from '@lib/common/constants'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection('posts')
  const sortedPosts = posts.sort(
    (a, b) =>
      new Date(a.data.published).getTime() -
      new Date(b.data.published).getTime()
  )
  return paginate(sortedPosts, { pageSize: 6 })
}) satisfies GetStaticPaths

const { page } = Astro.props
---

<StarwindLayout title='Blog Posts'>
  <div class='max-w-7xl mx-auto px-4 pt-10'>
    <div class='grid grid-cols-1 md:grid-cols-3 gap-6 mb-6'>
      {
        page.data.map((post) => (
          <Card prefix={BLOG_POST_ROOT} post={post} />
        ))
      }
    </div>
    <Paginate prefix={BLOG_PAGE_ROOT} page={page} />
  </div>
</StarwindLayout>
