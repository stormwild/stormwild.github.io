---
import Card from '@components/astro/v1light/card.astro'
import Paginate from '@components/astro/v1light/paginate.astro'
import V1LightLayout from '@layouts/v1-light-layout.astro'
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import { BLOG_PAGE_ROOT, BLOG_POST_ROOT } from '@lib/common/constants'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection('posts')

  const sortedPosts = posts.sort(
    (a, b) =>
      new Date(a.data.published).getTime() -
      new Date(b.data.published).getTime()
  )

  return paginate(sortedPosts, { pageSize: 6 })
}) satisfies GetStaticPaths

const { page } = Astro.props
---

<V1LightLayout title='Blog Posts'>
  <div class='max-w-6xl mx-auto px-6 pt-10 pb-16'>
    <p class='font-mono text-th-accent text-sm mb-1'>$ ls /blog ~/page/{page.currentPage}</p>
    <h1 class='text-3xl font-bold text-th-text mb-8'># all_posts</h1>
    <div class='grid grid-cols-1 md:grid-cols-3 gap-6 mb-8'>
      {page.data.map((post) => <Card prefix={BLOG_POST_ROOT} post={post} />)}
    </div>
    <Paginate prefix={BLOG_PAGE_ROOT} page={page} />
  </div>
</V1LightLayout>
