---
import StarwindLayout from '@layouts/starwind-layout.astro'
import { BLOG_TAGS_ROOT } from '@lib/common/constants'
import { join } from '@lib/util/join'
import { getCollection } from 'astro:content'

const posts = await getCollection('posts')
const tags = [...new Set(posts.map((post) => post.data.tags).flat())]
---

<StarwindLayout title='Tags'>
  <div class='max-w-7xl mx-auto px-4 pt-10 pb-16'>
    <h1 class='text-4xl font-bold text-white mb-8'>Tags</h1>
    <div class='flex flex-wrap gap-3'>
      {
        (tags as string[]).map((tag: string) => (
          <a
            href={join([BLOG_TAGS_ROOT, tag])}
            class='px-4 py-2 bg-gray-900 border border-gray-700 text-gray-300 hover:border-gray-500 hover:text-white rounded text-sm capitalize transition-colors'
          >
            {tag}
          </a>
        ))
      }
    </div>
  </div>
</StarwindLayout>
