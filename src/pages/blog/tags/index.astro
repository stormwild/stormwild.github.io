---
import BasecoatLayout from '@layouts/basecoat-layout.astro'
import { BLOG_TAGS_ROOT } from '@lib/common/constants'
import { join } from '@lib/util/join'
import { getCollection } from 'astro:content'

const posts = await getCollection('posts')
const tags = [...new Set(posts.map((post) => post.data.tags).flat())]
---

<BasecoatLayout title='Tags'>
  <div class='max-w-7xl mx-auto px-4 pt-10'>
    <h1 class='text-3xl font-bold text-white mb-8'>Tags</h1>
    <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
      {
        (tags as string[]).map((tag: string) => (
          <a
            href={join([BLOG_TAGS_ROOT, tag])}
            class='block p-4 bg-gray-900 border border-gray-700 rounded-lg hover:border-gray-500 hover:bg-gray-800 transition-colors'
          >
            <span class='text-gray-300 font-medium'>{tag}</span>
          </a>
        ))
      }
    </div>
  </div>
</BasecoatLayout>
