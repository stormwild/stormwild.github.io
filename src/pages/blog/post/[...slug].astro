---
import Navigate from '@components/astro/v1light/navigate.astro'
import V1LightPostLayout from '@layouts/v1-light-post-layout.astro'
import { BLOG_POST_ROOT } from '@lib/common/constants'
import { getCollection } from 'astro:content'

const posts = (await getCollection('posts')).sort(
  (a, b) =>
    new Date(a.data.published).getTime() - new Date(b.data.published).getTime()
)

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await entry.render()
---

<V1LightPostLayout frontmatter={entry.data}>
  <Content />
  <Navigate prefix={BLOG_POST_ROOT} post={entry} posts={posts} />
</V1LightPostLayout>
