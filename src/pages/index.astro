---
import Hero from '@components/astro/v1light/hero.astro'
import Skills from '@components/astro/v1light/skills.astro'
import Featured from '@components/astro/v1light/featured.astro'
import V1LightLayout from '@layouts/v1-light-layout.astro'
---

<V1LightLayout title='Home'>
  <Hero />
  <Skills />
  <div class='max-w-6xl mx-auto px-6 pb-16'>
    <p class='font-mono text-sm text-gray-400 mb-1'>
      <span class='text-teal-600'>//</span> featured_posts
    </p>
    <h2 class='text-2xl font-bold text-gray-900 mb-8'>Featured Writing</h2>
    <Featured />
  </div>
</V1LightLayout>
