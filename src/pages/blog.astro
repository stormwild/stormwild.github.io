---
import Card from '@components/astro/basecoat/card.astro'
import BasecoatLayout from '@layouts/basecoat-layout.astro'
import { getCollection } from 'astro:content'
import { BLOG_PAGE_ROOT, BLOG_POST_ROOT } from '@lib/common/constants'
import { join } from '@lib/util/join'
import Featured from '@components/astro/basecoat/featured.astro'

const posts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true
})

const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime()
)

const notFeatured = sortedPosts.filter((post) => !post.data.tags.includes('featured'))
const latestPosts = notFeatured.slice(0, 10)
const prefix = BLOG_PAGE_ROOT
---

<BasecoatLayout title='Blog'>
  <div class='max-w-7xl mx-auto px-4 pt-10'>
    <Featured />
    <div class='grid grid-cols-1 md:grid-cols-3 gap-6 mb-8'>
      {latestPosts.map((post) => <Card prefix={BLOG_POST_ROOT} post={post} />)}
    </div>
    <div class='flex justify-end mb-10'>
      <a
        href={join([prefix, '1'])}
        class='px-5 py-2 border border-gray-600 text-gray-300 hover:border-gray-400 hover:text-white rounded text-sm transition-colors'
      >
        View All Posts &raquo;
      </a>
    </div>
  </div>
</BasecoatLayout>
