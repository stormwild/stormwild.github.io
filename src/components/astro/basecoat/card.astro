---
import { BLOG_POST_ROOT } from '@lib/common/constants'
import { join } from '@lib/util/join'
import { Image } from 'astro:assets'

const { prefix = BLOG_POST_ROOT, post } = Astro.props
---

<div class='bg-gray-900 border border-gray-800 rounded-lg overflow-hidden flex flex-col h-full hover:border-gray-600 transition-colors'>
  <Image src={post.data.image} alt={post.data.title} class='w-full h-48 object-cover' />
  <div class='p-4 flex flex-col flex-1'>
    <h5 class='text-white font-semibold mb-2 leading-snug'>{post.data.title}</h5>
    <p class='text-gray-400 text-sm mb-4 flex-1 leading-relaxed'>{post.data.description}</p>
    <a
      href={join([prefix, post.slug])}
      class='text-blue-400 hover:text-blue-300 text-sm flex items-center gap-1 transition-colors'
    >
      Continue reading
      <svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' fill='currentColor' viewBox='0 0 16 16'>
        <path fill-rule='evenodd' d='M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708'></path>
      </svg>
    </a>
  </div>
  <div class='px-4 py-2 border-t border-gray-800'>
    <small class='text-gray-600 text-xs'>
      {new Date(post.data.published).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
    </small>
  </div>
</div>
