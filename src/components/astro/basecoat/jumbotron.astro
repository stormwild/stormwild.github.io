---
import { Image } from 'astro:assets'
import alex from '@assets/img/alex-torrijos.jpg'
---

<section class='bg-gray-900 py-16 mb-10'>
  <div class='max-w-7xl mx-auto px-4'>
    <div class='flex flex-col-reverse lg:flex-row items-center gap-10'>
      <div class='flex-1'>
        <h1 class='text-4xl font-bold text-white mb-4'>Full Stack Developer</h1>
        <p class='text-gray-300 mb-3'>Alex is a Full Stack Developer specializing in:</p>
        <div class='flex flex-wrap gap-2 mb-6'>
          {['C#', '.NET', 'EF Core', 'SQL Server', 'ReactJs', 'Angular'].map((s) => (
            <span class='px-3 py-1 text-sm bg-gray-800 text-gray-200 rounded border border-gray-700'>{s}</span>
          ))}
        </div>
        <p class='text-gray-400 mb-3 text-sm leading-relaxed'>
          Excels as an individual contributor, with strong problem-solving and communication skills.
          Experience building applications from scratch, enhancing existing ones, and working as part
          of a team or independently.
        </p>
        <p class='text-gray-400 mb-3 text-sm leading-relaxed'>
          Committed to delivering high-quality software solutions, adhering to the best practices of
          SOLID design principles, and writing clean, efficient, and well-tested code.
        </p>
        <p class='text-gray-400 mb-6 text-sm leading-relaxed'>
          Worked on a variety of projects, from small software consultancies, design agencies to large corporations.
        </p>
        <div class='flex flex-wrap gap-2'>
          {[
            { href: 'https://www.linkedin.com/in/stormwild/', label: 'LinkedIn' },
            { href: 'https://github.com/stormwild/', label: 'Github' },
            { href: 'https://stackoverflow.com/users/92189/stormwild', label: 'Stackoverflow' },
            { href: 'https://codepen.io/stormwild/', label: 'CodePen' },
          ].map((link) => (
            <a
              href={link.href}
              target='_blank'
              rel='noopener noreferrer'
              class='px-4 py-2 text-sm border border-gray-600 text-gray-300 hover:border-gray-400 hover:text-white rounded transition-colors'
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
      <div class='flex-shrink-0 text-center'>
        <figure>
          <Image
            src={alex}
            alt='Alexander Torrijos'
            width='320'
            height='320'
            class='rounded-full border-4 border-gray-700 object-cover'
            loading='eager'
          />
          <figcaption class='text-gray-500 text-sm mt-2'>Alexander R. Torrijos</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
