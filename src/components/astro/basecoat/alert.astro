---
const { variant = 'info' } = Astro.props

const variantClasses: Record<string, string> = {
  info: 'bg-blue-950 border-blue-800 text-blue-200',
  success: 'bg-green-950 border-green-800 text-green-200',
  warning: 'bg-yellow-950 border-yellow-800 text-yellow-200',
  danger: 'bg-red-950 border-red-800 text-red-200',
  dark: 'bg-gray-900 border-gray-700 text-gray-200',
}

const classes = variantClasses[variant] ?? variantClasses.info
---

<div class={`border rounded-lg px-4 py-3 text-sm ${classes}`} role='alert'>
  <slot>Set Alert Message</slot>
</div>
