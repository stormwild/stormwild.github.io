---
import { join } from '@lib/util/join'
---

<div class='max-w-7xl mx-auto px-4 py-20 text-center'>
  <p class='text-6xl text-gray-700 font-bold mb-4'>404</p>
  <p class='text-2xl text-gray-400 mb-8'>Oops! Looks like you're lost in space.</p>
  <a href={join(['/'])} class='inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors'>
    <svg class='w-4 h-4'><use xlink:href='#chevron-left'></use></svg>
    Return home
  </a>
</div>
