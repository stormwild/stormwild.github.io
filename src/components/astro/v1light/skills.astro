---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'

const skills = await getCollection('skills')
skills.sort((a, b) => a.data.order - b.data.order)
---

<section class='bg-th-raised py-16'>
  <div class='max-w-6xl mx-auto px-6'>
    <p class='font-mono text-sm text-th-faint mb-1'>
      <span class='text-th-accent'>//</span> tech_stack
    </p>
    <h2 class='text-2xl font-bold text-th-text mb-10'>Technologies &amp; Tools</h2>
    <div class='grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4'>
      {skills.map((skill) => (
        <div class='bg-th-surface border border-th-border rounded-lg p-4 flex flex-col items-center text-center hover:border-th-ring transition-colors'>
          <Image src={skill.data.logo} alt={skill.data.skill} width={60} height={60} class='object-contain mb-3' loading='eager' />
          <h4 class='text-th-text font-semibold text-sm mb-1'>{skill.data.skill}</h4>
          <div class='w-full bg-th-border rounded-full h-1.5 mt-2'>
            <div class='bg-th-accent h-1.5 rounded-full' style={`width: ${skill.data.proficiency * 10}%`}></div>
          </div>
          <span class='text-xs text-th-faint mt-1'>{skill.data.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
