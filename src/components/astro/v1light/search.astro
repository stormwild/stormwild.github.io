---
---

<div class='relative'>
  <div id='search-container' class='relative'>
    <input
      id='pagefind-search'
      type='text'
      placeholder='search...'
      class='w-full px-3 py-1.5 rounded text-sm font-mono focus:outline-none'
      style='background: var(--th-surface); border: 1px solid var(--th-border); color: var(--th-text);'
      autocomplete='off'
    />
    <div
      id='search-results'
      class='absolute top-full left-0 right-0 rounded mt-1 shadow-lg z-50 hidden max-h-80 overflow-y-auto'
      style='background: var(--th-surface); border: 1px solid var(--th-border);'
    >
    </div>
  </div>
</div>

<script>
  let pagefind: any = null

  async function initPagefind() {
    try {
      pagefind = await import('/pagefind/pagefind.js' as any)
      await pagefind.init()
    } catch (e) {
      // pagefind not available in dev
    }
  }

  initPagefind()

  const input = document.getElementById('pagefind-search') as HTMLInputElement
  const results = document.getElementById('search-results') as HTMLDivElement

  if (input && results) {
    input.addEventListener('input', async (e) => {
      const query = (e.target as HTMLInputElement).value.trim()
      if (!query || !pagefind) {
        results.classList.add('hidden')
        results.innerHTML = ''
        return
      }
      const search = await pagefind.search(query)
      const data = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()))
      if (data.length === 0) {
        results.innerHTML = '<p class="px-4 py-3 text-sm font-mono" style="color: var(--th-muted)">no results found</p>'
      } else {
        results.innerHTML = data.map((d: any) =>
          `<a href="${d.url}" class="block px-4 py-3 last:border-0" style="border-bottom: 1px solid var(--th-border);">
            <p class="text-sm font-medium" style="color: var(--th-text)">${d.meta?.title || 'Untitled'}</p>
            <p class="text-xs truncate mt-0.5" style="color: var(--th-muted)">${d.excerpt || ''}</p>
          </a>`
        ).join('')
      }
      results.classList.remove('hidden')
    })

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target as Node) && !results.contains(e.target as Node)) {
        results.classList.add('hidden')
      }
    })
  }
</script>
