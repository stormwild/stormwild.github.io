---
import { pages } from '@lib/nav/pages'
import ThemePicker from '@components/astro/v1light/theme-picker.astro'
---

<header class='border-b border-th-border sticky top-0 z-50 backdrop-blur-sm' style='background-color: var(--th-header-bg)'>
  <nav class='max-w-6xl mx-auto px-6 flex items-center justify-between h-14'>
    <a href='/' class='nav-logo font-mono text-th-text font-semibold text-sm tracking-tight hover:text-th-accent transition-colors'>
      &gt; stormwild
    </a>

    <div class='hidden md:flex items-center gap-8'>
      {pages.map((page) => (
        <a href={page.href} class='nav-link text-th-muted hover:text-th-text text-sm transition-colors font-mono capitalize'>
          {page.text}
        </a>
      ))}
      <a href='/rss.xml' class='text-th-faint hover:text-th-muted transition-colors' title='RSS'>
        <svg class='w-4 h-4' fill='currentColor' viewBox='0 0 20 20'>
          <path d='M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z'></path>
          <path d='M4 9a1 1 0 000 2 7 7 0 017 7 1 1 0 102 0 9 9 0 00-9-9z'></path>
          <circle cx='3' cy='19' r='2'></circle>
        </svg>
      </a>
      <ThemePicker />
    </div>

    <div class='flex items-center gap-2 md:hidden'>
      <ThemePicker />
      <button id='mobile-toggle' class='text-th-muted hover:text-th-text p-1 transition-colors' aria-label='Toggle menu'>
        <svg class='w-5 h-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'>
          <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M4 6h16M4 12h16M4 18h16'></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id='mobile-nav' class='hidden md:hidden border-t border-th-border px-6 py-4 flex flex-col gap-4' style='background-color: var(--th-bg)'>
    {pages.map((page) => (
      <a href={page.href} class='nav-link text-th-muted hover:text-th-text text-sm font-mono capitalize transition-colors'>
        {page.text}
      </a>
    ))}
  </div>
</header>

<script>
  document.getElementById('mobile-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-nav')?.classList.toggle('hidden')
  })

  const pathname = window.location.pathname
  document.querySelectorAll<HTMLAnchorElement>('.nav-link').forEach((link) => {
    const href = link.getAttribute('href')
    if (href === pathname || href === pathname.slice(0, -1)) {
      link.style.color = 'var(--th-accent)'
      link.style.fontWeight = '600'
    }
  })
</script>
