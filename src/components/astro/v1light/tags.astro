---
import { BLOG_TAGS_ROOT } from '@lib/common/constants'
import { join } from '@lib/util/join'

const { prefix = BLOG_TAGS_ROOT, tags } = Astro.props
---

<div class='bg-th-surface border border-th-border rounded-lg mb-6'>
  <div class='flex items-center gap-2 px-4 py-3 border-b border-th-border'>
    <span class='text-th-accent font-mono text-sm'>//</span>
    <a href={join([BLOG_TAGS_ROOT])} class='text-th-text font-semibold text-sm hover:text-th-accent transition-colors'>
      tags
    </a>
  </div>
  <div class='p-4 flex flex-wrap gap-2'>
    {tags.map((tag: string) => (
      <a
        href={join([prefix, tag])}
        class='px-3 py-1 text-xs font-mono bg-th-raised border border-th-border text-th-muted hover:border-th-accent hover:text-th-accent rounded transition-colors capitalize'
      >
        {tag}
      </a>
    ))}
  </div>
</div>
