---
import { join } from '@lib/util/join'
---

<div class='max-w-6xl mx-auto px-6 py-20 text-center'>
  <p class='font-mono text-teal-600 text-sm mb-4'>$ error --code 404</p>
  <p class='text-6xl font-bold text-gray-200 mb-4'>404</p>
  <p class='text-xl text-gray-500 mb-8'>Page not found.</p>
  <a
    href={join(['/'])}
    class='inline-flex items-center gap-2 text-teal-600 hover:text-teal-700 text-sm font-mono transition-colors'
  >
    ← return_home()
  </a>
</div>
