---
import { BLOG_POST_ROOT } from '@lib/common/constants'
import { join } from '@lib/util/join'
import { Image } from 'astro:assets'

const { prefix = BLOG_POST_ROOT, post } = Astro.props
---

<div class='bg-th-surface border border-th-border rounded-lg overflow-hidden flex flex-col h-full hover:border-th-ring transition-colors'>
  <Image src={post.data.image} alt={post.data.title} class='w-full h-44 object-cover' />
  <div class='p-4 flex flex-col flex-1'>
    <h5 class='text-th-text font-semibold mb-2 leading-snug'>{post.data.title}</h5>
    <p class='text-th-muted text-sm mb-4 flex-1 leading-relaxed'>{post.data.description}</p>
    <a href={join([prefix, post.slug])} class='text-th-accent hover:text-th-accent-h text-sm flex items-center gap-1 transition-colors font-mono'>
      read_more →
    </a>
  </div>
  <div class='px-4 py-2 border-t border-th-border'>
    <small class='text-th-faint text-xs font-mono'>
      {new Date(post.data.published).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
    </small>
  </div>
</div>
