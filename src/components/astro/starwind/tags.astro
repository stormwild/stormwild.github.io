---
import { BLOG_TAGS_ROOT } from '@lib/common/constants'
import { join } from '@lib/util/join'

const { prefix = BLOG_TAGS_ROOT, tags } = Astro.props
---

<div class='bg-gray-900 border border-gray-800 rounded-lg mb-6'>
  <div class='flex items-center gap-2 px-4 py-3 border-b border-gray-800'>
    <svg
      xmlns='http://www.w3.org/2000/svg'
      width='16'
      height='16'
      fill='currentColor'
      class='text-gray-400'
      viewBox='0 0 16 16'
    >
      <path
        d='M2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586zm3.5 4a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3'
      ></path>
      <path
        d='M1.293 7.793A1 1 0 0 1 1 7.086V2a1 1 0 0 0-1 1v4.586a1 1 0 0 0 .293.707l7 7a1 1 0 0 0 1.414 0l.043-.043z'
      ></path>
    </svg>
    <a
      href={join([BLOG_TAGS_ROOT])}
      class='text-gray-200 font-semibold text-sm hover:text-white transition-colors'
    >
      Tags
    </a>
  </div>
  <ul class='divide-y divide-gray-800'>
    {
      tags.map((tag: string) => (
        <li>
          <a
            href={join([prefix, tag])}
            class='block px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800 transition-colors capitalize'
          >
            {tag}
          </a>
        </li>
      ))
    }
  </ul>
</div>
