---
import BasecoatLayout from '@layouts/basecoat-layout.astro'
import { BLOG_PAGE_ROOT } from '@lib/common/constants'
import { join } from '@lib/util/join'
import Tags from '@components/astro/basecoat/tags.astro'
import { Image } from 'astro:assets'

const { frontmatter } = Astro.props

const { title, published, tags, image } = frontmatter

const prefix = BLOG_PAGE_ROOT
---

<BasecoatLayout title={title}>
  <div class='max-w-7xl mx-auto px-4 pt-10'>
    <div class='flex flex-col md:flex-row gap-8'>
      <div class='md:w-2/3'>
        <h1 class='text-4xl font-bold text-white mb-6'>{title}</h1>
        <Image
          src={image}
          alt={title}
          class='w-full rounded-lg mb-4 object-cover'
        />
        <p class='text-gray-400 flex justify-between text-sm mb-6'>
          <em>{frontmatter.description}</em>
          <span>{new Date(published).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
        </p>
        <hr class='border-gray-700 mb-6' />
        <div class='prose-basecoat'>
          <slot />
        </div>
      </div>
      <div class='md:w-1/3'>
        <Tags tags={tags} />
        <div class='flex justify-end mt-4'>
          <a href={join([prefix, '1'])} class='px-4 py-2 border border-gray-600 text-gray-300 hover:border-gray-400 hover:text-white rounded text-sm transition-colors'>
            View All Posts &raquo;
          </a>
        </div>
      </div>
    </div>
  </div>
</BasecoatLayout>

<style is:global>
  .prose-basecoat {
    color: #d1d5db;
    line-height: 1.75;
  }
  .prose-basecoat h1, .prose-basecoat h2, .prose-basecoat h3,
  .prose-basecoat h4, .prose-basecoat h5, .prose-basecoat h6 {
    color: #f9fafb;
    font-weight: 700;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .prose-basecoat p { margin-bottom: 1rem; font-size: 1.1rem; font-weight: 300; }
  .prose-basecoat a { color: #60a5fa; text-decoration: underline; word-break: break-all; }
  .prose-basecoat a:hover { color: #93c5fd; }
  .prose-basecoat code { background: #1f2937; color: #e5e7eb; padding: 0.1em 0.3em; border-radius: 0.25rem; font-size: 0.875em; }
  .prose-basecoat pre { background: #111827; padding: 1rem; border-radius: 0.375rem; overflow-x: auto; margin-bottom: 1rem; }
  .prose-basecoat pre code { background: none; padding: 0; color: inherit; }
  .prose-basecoat blockquote { border-left: 4px solid #374151; padding: 0.5rem 1rem; margin: 1rem 0; background: rgba(55,65,81,0.5); color: #9ca3af; }
  .prose-basecoat ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1rem; }
  .prose-basecoat ol { list-style: decimal; padding-left: 1.5rem; margin-bottom: 1rem; }
  .prose-basecoat li { margin-bottom: 0.25rem; font-size: 1.1rem; font-weight: 300; line-height: 2rem; }
  .prose-basecoat table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
  .prose-basecoat th, .prose-basecoat td { border: 1px solid #374151; padding: 0.5rem; text-align: left; }
  .prose-basecoat th { background: #1f2937; color: #f3f4f6; }
  .prose-basecoat tr:nth-child(odd) td { background: rgba(31,41,55,0.4); }
  .prose-basecoat img { max-width: 100%; height: auto; border-radius: 0.375rem; }
  .astro-code { padding: 1rem; border: 1px solid rgba(85,85,85,0.33); border-radius: 0.25rem; }
</style>
