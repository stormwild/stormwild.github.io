---
import V1LightLayout from '@layouts/v1-light-layout.astro'
import { BLOG_PAGE_ROOT } from '@lib/common/constants'
import { join } from '@lib/util/join'
import Tags from '@components/astro/v1light/tags.astro'
import { Image } from 'astro:assets'

const { frontmatter } = Astro.props

const { title, published, tags, image } = frontmatter

const prefix = BLOG_PAGE_ROOT
---

<V1LightLayout title={title}>
  <div class='max-w-6xl mx-auto px-6 pt-10 pb-16'>
    <div class='flex flex-col md:flex-row gap-8'>
      <div class='md:w-2/3'>
        <p class='font-mono text-teal-600 text-xs mb-2'>$ cat /blog/post</p>
        <h1 class='text-4xl font-bold text-gray-900 mb-6'>{title}</h1>
        <Image
          src={image}
          alt={title}
          class='w-full rounded-lg mb-4 object-cover'
        />
        <p class='text-gray-500 flex justify-between text-sm mb-6'>
          <em>{frontmatter.description}</em>
          <span class='font-mono'>{new Date(published).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
        </p>
        <hr class='border-gray-200 mb-6' />
        <div class='prose-v1light'>
          <slot />
        </div>
      </div>
      <div class='md:w-1/3'>
        <Tags tags={tags} />
        <div class='flex justify-end mt-4'>
          <a href={join([prefix, '1'])} class='px-4 py-2 border border-gray-200 text-gray-600 hover:border-teal-400 hover:text-teal-600 rounded text-sm font-mono transition-colors'>
            view_all_posts →
          </a>
        </div>
      </div>
    </div>
  </div>
</V1LightLayout>

<style is:global>
  .prose-v1light {
    color: #374151;
    line-height: 1.75;
  }
  .prose-v1light h1, .prose-v1light h2, .prose-v1light h3,
  .prose-v1light h4, .prose-v1light h5, .prose-v1light h6 {
    color: #111827;
    font-weight: 700;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .prose-v1light p { margin-bottom: 1rem; font-size: 1.1rem; font-weight: 300; }
  .prose-v1light a { color: #0d9488; text-decoration: underline; word-break: break-all; }
  .prose-v1light a:hover { color: #0f766e; }
  .prose-v1light code { background: #f3f4f6; color: #111827; padding: 0.1em 0.3em; border-radius: 0.25rem; font-size: 0.875em; font-family: monospace; }
  .prose-v1light pre { background: #f9fafb; border: 1px solid #e5e7eb; padding: 1rem; border-radius: 0.375rem; overflow-x: auto; margin-bottom: 1rem; }
  .prose-v1light pre code { background: none; padding: 0; color: inherit; }
  .prose-v1light blockquote { border-left: 4px solid #d1d5db; padding: 0.5rem 1rem; margin: 1rem 0; background: #f9fafb; color: #6b7280; }
  .prose-v1light ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1rem; }
  .prose-v1light ol { list-style: decimal; padding-left: 1.5rem; margin-bottom: 1rem; }
  .prose-v1light li { margin-bottom: 0.25rem; font-size: 1.1rem; font-weight: 300; line-height: 2rem; }
  .prose-v1light table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
  .prose-v1light th, .prose-v1light td { border: 1px solid #e5e7eb; padding: 0.5rem; text-align: left; }
  .prose-v1light th { background: #f3f4f6; color: #111827; font-weight: 600; }
  .prose-v1light tr:nth-child(odd) td { background: #f9fafb; }
  .prose-v1light img { max-width: 100%; height: auto; border-radius: 0.375rem; }
  .astro-code { padding: 1rem; border: 1px solid #e5e7eb; border-radius: 0.25rem; }
</style>
