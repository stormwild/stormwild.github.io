---
import V1LightLayout from '@layouts/v1-light-layout.astro'
import { BLOG_PAGE_ROOT } from '@lib/common/constants'
import { join } from '@lib/util/join'
import Tags from '@components/astro/v1light/tags.astro'
import { Image } from 'astro:assets'

const { frontmatter } = Astro.props

const { title, published, tags, image } = frontmatter

const prefix = BLOG_PAGE_ROOT
---

<V1LightLayout title={title}>
  <div class='max-w-6xl mx-auto px-6 pt-10 pb-16'>
    <div class='flex flex-col md:flex-row gap-8'>
      <div class='md:w-2/3'>
        <p class='font-mono text-th-accent text-xs mb-2'>$ cat /blog/post</p>
        <h1 class='text-4xl font-bold text-th-text mb-6'>{title}</h1>
        <Image src={image} alt={title} class='w-full rounded-lg mb-4 object-cover' />
        <p class='text-th-muted flex justify-between text-sm mb-6'>
          <em>{frontmatter.description}</em>
          <span class='font-mono'>{new Date(published).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
        </p>
        <hr class='border-th-border mb-6' />
        <div class='prose-v1light'>
          <slot />
        </div>
      </div>
      <div class='md:w-1/3'>
        <Tags tags={tags} />
        <div class='flex justify-end mt-4'>
          <a href={join([prefix, '1'])} class='px-4 py-2 border border-th-border text-th-muted hover:border-th-accent hover:text-th-accent rounded text-sm font-mono transition-colors'>
            view_all_posts →
          </a>
        </div>
      </div>
    </div>
  </div>
</V1LightLayout>

<style is:global>
  /* Prose uses CSS variables so it adapts to all themes automatically */
  .prose-v1light {
    color: var(--th-prose-text);
    line-height: 1.75;
  }
  .prose-v1light h1, .prose-v1light h2, .prose-v1light h3,
  .prose-v1light h4, .prose-v1light h5, .prose-v1light h6 {
    color: var(--th-prose-heading);
    font-weight: 700;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .prose-v1light p { margin-bottom: 1rem; font-size: 1.1rem; font-weight: 300; }
  .prose-v1light a { color: var(--th-prose-link); text-decoration: underline; word-break: break-all; }
  .prose-v1light a:hover { color: var(--th-prose-link-h); }
  .prose-v1light code { background: var(--th-code-bg); color: var(--th-code-text); padding: 0.1em 0.3em; border-radius: 0.25rem; font-size: 0.875em; font-family: monospace; }
  .prose-v1light pre { border: 1px solid var(--th-border); padding: 1rem; border-radius: 0.375rem; overflow-x: auto; margin-bottom: 1rem; }
  .prose-v1light pre code { background: none; padding: 0; color: inherit; }
  .prose-v1light blockquote { border-left: 4px solid var(--th-prose-blockquote-border); padding: 0.5rem 1rem; margin: 1rem 0; background: var(--th-prose-blockquote-bg); color: var(--th-prose-blockquote-text); }
  .prose-v1light ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1rem; }
  .prose-v1light ol { list-style: decimal; padding-left: 1.5rem; margin-bottom: 1rem; }
  .prose-v1light li { margin-bottom: 0.25rem; font-size: 1.1rem; font-weight: 300; line-height: 2rem; }
  .prose-v1light table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
  .prose-v1light th, .prose-v1light td { border: 1px solid var(--th-prose-table-border); padding: 0.5rem; text-align: left; }
  .prose-v1light th { background: var(--th-prose-table-head-bg); color: var(--th-prose-heading); font-weight: 600; }
  .prose-v1light tr:nth-child(odd) td { background: var(--th-prose-table-stripe); }
  .prose-v1light img { max-width: 100%; height: auto; border-radius: 0.375rem; }
  .astro-code { padding: 1rem; border: 1px solid var(--th-border) !important; border-radius: 0.25rem; }
</style>
