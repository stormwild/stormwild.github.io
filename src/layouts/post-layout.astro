---
import StarwindLayout from '@layouts/starwind-layout.astro'
import { BLOG_PAGE_ROOT } from '@lib/common/constants'
import { join } from '@lib/util/join'
import Tags from '@components/astro/starwind/tags.astro'
import { Image } from 'astro:assets'

const { frontmatter } = Astro.props
const { title, published, tags, image } = frontmatter
const prefix = BLOG_PAGE_ROOT
---

<StarwindLayout title={title}>
  <div class='max-w-7xl mx-auto px-4 pt-10 pb-16'>
    <div class='grid grid-cols-1 md:grid-cols-3 gap-10'>
      <div class='md:col-span-2'>
        <h1 class='text-4xl font-bold text-white mb-6 leading-tight'>{title}</h1>
        <Image
          src={image}
          alt={title}
          class='w-full rounded-lg mb-4 object-cover'
        />
        <div class='flex justify-between items-center text-gray-500 text-sm mb-6'>
          <em class='text-gray-400'>{frontmatter.description}</em>
          <span>
            {
              new Date(published).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })
            }
          </span>
        </div>
        <hr class='border-gray-800 mb-8' />
        <div class='prose-starwind'>
          <slot />
        </div>
      </div>

      <div>
        <Tags tags={tags} />
        <div class='flex justify-end mt-4'>
          <a
            href={join([prefix, '1'])}
            class='px-4 py-2 border border-gray-600 text-gray-300 hover:border-gray-400 hover:text-white rounded text-sm transition-colors'
          >
            View All Posts &raquo;
          </a>
        </div>
      </div>
    </div>
  </div>
</StarwindLayout>

<style is:global>
  .prose-starwind h1,
  .prose-starwind h2,
  .prose-starwind h3,
  .prose-starwind h4 {
    color: #f1f5f9;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .prose-starwind p {
    color: #94a3b8;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .prose-starwind a {
    color: #60a5fa;
    word-break: break-all;
  }

  .prose-starwind a:hover {
    color: #93c5fd;
  }

  .prose-starwind .astro-code {
    padding: 1rem;
    border: 1px solid #1e293b;
    border-radius: 0.375rem;
    margin-bottom: 1rem;
    overflow-x: auto;
  }

  .prose-starwind blockquote {
    background-color: rgba(30, 41, 59, 0.75);
    padding: 0.5rem 1rem;
    margin: 0 0 1rem;
    border-left: 0.25rem solid rgba(148, 163, 184, 0.4);
    color: #94a3b8;
  }

  .prose-starwind table {
    width: 100%;
    margin-bottom: 1rem;
    color: #cbd5e1;
    border-collapse: collapse;
  }

  .prose-starwind table th,
  .prose-starwind table td {
    padding: 0.5rem;
    border: 1px solid #1e293b;
  }

  .prose-starwind table thead th {
    background-color: #1e293b;
  }

  .prose-starwind table tbody tr:nth-of-type(odd) td {
    background-color: rgba(30, 41, 59, 0.4);
  }

  .prose-starwind img {
    max-width: 100%;
    height: auto;
    border-radius: 0.375rem;
  }

  .prose-starwind ul,
  .prose-starwind ol {
    color: #94a3b8;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .prose-starwind li {
    margin-bottom: 0.25rem;
  }

  .prose-starwind hr {
    border-color: #1e293b;
    margin: 1.5rem 0;
  }
</style>
